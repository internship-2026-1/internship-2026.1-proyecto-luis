DJANGO_SECRET_KEY=django-insecure-key
DJANGO_DEBUG=1

# Database engine selector for Django
USERS_DB_ENGINE=postgresql
CORE_DB_ENGINE=postgresql

# Primary DB variables consumed by Django settings
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=users_pass
USERS_DB_HOST=users_db
USERS_DB_PORT=5432

CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_pass
CORE_DB_HOST=core_db
CORE_DB_PORT=5432

# Compatibility aliases consumed by Postgres container
POSTGRES_DB=users_db
POSTGRES_USER=users_user
POSTGRES_PASSWORD=users_pass
POSTGRES_HOST=users_db
POSTGRES_PORT=5432

# MongoDB variables consumed by docker-compose and servicecore
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=core_db
MONGO_AUTH_SOURCE=admin
MONGO_PRODUCT_COLLECTION=products

# PgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@ip.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Odoo credentials
ODOO_URL=https://internship2026.odoo.com
ODOO_DB=internship2026
ODOO_USERNAME=pasantiaciancoders@gmail.com
ODOO_API_KEY=5f83e4eb8ac96d09a933a358fae02dee45d20d38

# Internal sync token
INTERNAL_SYNC_TOKEN=mi_token_super_secreto_123

# CORS Configuration
# Orígenes permitidos para CORS (regex patterns separados por coma)
# Por defecto permite localhost y 127.0.0.1 en cualquier puerto
CORS_ALLOWED_ORIGIN_REGEXES=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
